<Window
	x:Class="Sudoku.Graphics.UI.Views.OtherWindows.AboutWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI.Views.OtherWindows"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	xmlns:vm="clr-namespace:Sudoku.Graphics.UI.ViewModels"
	xmlns:vc="clr-namespace:Sudoku.Graphics.UI.ValueConverters"
	mc:Ignorable="d"
	Title="{x:Static p:Resources.AboutWindow_Title}" MaxHeight="100" Width="400" ResizeMode="NoResize">
	<Window.DataContext>
		<vm:AboutWindowViewModel/>
	</Window.DataContext>
    <Window.Resources>
        <vc:UriValueConverter x:Key="UriValueConverter" />
    </Window.Resources>

	<Grid RowDefinitions="*,*,*" ColumnDefinitions="100,*" Margin="10">
        <TextBlock Grid.Row="0" Grid.Column="0">
			<Bold>
				<Run Text="{x:Static p:Resources.AboutWindow_Author}"/>
			</Bold>
		</TextBlock>
		<TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Static p:Resources.AboutWindow_AuthorName}"/>
        <TextBlock Grid.Row="1" Grid.Column="0">
			<Bold>
				<Run Text="{x:Static p:Resources.AboutWindow_AuthorGitHub}"/>
			</Bold>
		</TextBlock>
        <TextBlock Grid.Row="1" Grid.Column="1">
			<Hyperlink NavigateUri="{Binding GitHubPage}" RequestNavigate="Hyperlink_RequestNavigate">
				<Hyperlink.Inlines>
					<Run Text="{x:Static p:Resources.AboutWindow_ClickMe}"/>
				</Hyperlink.Inlines>
			</Hyperlink>
        </TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="0">
			<Bold>
				<Run Text="{x:Static p:Resources.AboutWindow_Bilibili}"/>
			</Bold>
		</TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static p:Resources.AboutWindow_BilibiliName}"/>
    </Grid>
</Window>
