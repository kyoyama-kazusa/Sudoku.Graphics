<Window
	x:Class="Sudoku.Graphics.UI.Views.OtherWindows.CreateNewCanvasWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI.Views.OtherWindows"
	xmlns:vm="clr-namespace:Sudoku.Graphics.UI.ViewModels"
	xmlns:tabs="clr-namespace:Sudoku.Graphics.UI.Views.TabItems"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	d:DataContext="{d:DesignInstance Type=vm:CreateNewCanvasWindowViewModel}"
	mc:Ignorable="d"
	Title="{x:Static p:Resources.CreateNewCanvasWindow_Title}"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	Width="800"
	Height="600">
	<Window.Resources>
		<Style TargetType="TextBox">
			<Setter Property="Width" Value="60"/>
		</Style>
		<DataTemplate DataType="{x:Type vm:CreateNewCanvas_StandardTabItemViewModel}">
			<tabs:CreateNewCanvas_StandardTabItem/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type vm:CreateNewCanvas_LatinSquareTabItemViewModel}">
			<tabs:CreateNewCanvas_DefaultTabItem/>
		</DataTemplate>
	</Window.Resources>

	<StackPanel>
		<!--Segmented-->
		<TabControl
			Margin="6"
			ItemsSource="{Binding Tabs}"
			SelectedItem="{Binding SelectedTab,UpdateSourceTrigger=PropertyChanged}">
			<TabControl.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Title}" Margin="3"/>
				</DataTemplate>
			</TabControl.ItemTemplate>
		</TabControl>

		<!--Output picture size-->
		<StackPanel Margin="0,6" Orientation="Horizontal">
			<TextBlock Margin="0,0,6,0">
				<Bold>
					<Run Text="{x:Static p:Resources.CreateNewCanvasWindow_OutputPictureSize}"/>
				</Bold>
			</TextBlock>
			<TextBlock Text="{Binding SelectedTab.TargetPictureSizeString,UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<!--Buttons-->
		<Border Margin="0,20,0,0" BorderThickness="0,0.5,0,0" BorderBrush="Gray">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
				<Button
					Content="{x:Static p:Resources.CreateNewCanvasWindow_Okay}"
					Command="{Binding OkCommand}"
					Margin="0,0,8,0"/>
				<Button
					Content="{x:Static p:Resources.CreateNewCanvasWindow_Cancel}"
					Command="{Binding CancelCommand}"/>
			</StackPanel>
		</Border>
	</StackPanel>
</Window>
