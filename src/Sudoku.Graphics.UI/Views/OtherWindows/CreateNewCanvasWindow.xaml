<Window
	x:Class="Sudoku.Graphics.UI.Views.OtherWindows.CreateNewCanvasWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI.Views.OtherWindows"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	xmlns:c="clr-namespace:Sudoku.Graphics.UI.Views.Controls"
	xmlns:vcvt="clr-namespace:Sudoku.Graphics.UI.ValueConverters"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=local:CreateNewCanvasWindow}"
	Title="{x:Static p:LocalizationResources.CreateNewCanvasWindow_Title}"
	Width="600"
	Height="450"
	WindowStartupLocation="CenterOwner">
	<Window.Resources>
		<vcvt:TemplateModeToVisibilityConverter x:Key="TemplateModeToVisibilityConverter"/>
		<vcvt:ThreeStateBooleanToBooleanConverter x:Key="ThreeStateBooleanToBooleanConverter" TreatNullAsFalse="True" />
	</Window.Resources>
	
	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
		<StackPanel Orientation="Vertical">
			<StackPanel.Resources>
				<Style TargetType="StackPanel">
					<Setter Property="Orientation" Value="Horizontal" />
					<Setter Property="Margin" Value="6,4" />
				</Style>
				<Style TargetType="TextBlock" x:Key="PropertyNameTextBlockStyle">
					<Setter Property="Width" Value="160" />
				</Style>
				<Style TargetType="c:IntegerBox">
					<Setter Property="Width" Value="100" />
				</Style>
			</StackPanel.Resources>

			<StackPanel Margin="6,8,0,10">
				<StackPanel.Resources>
					<Style TargetType="RadioButton">
						<Setter Property="Margin" Value="0,0,12,0" />
					</Style>
				</StackPanel.Resources>

				<RadioButton
					Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_StandardTemplate}"
					IsChecked="{Binding IsStandardMode,Mode=OneWay}"
					Checked="StandardTemplateRadioButton_Checked" />
				<RadioButton
					Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_DefaultTemplate}"
					IsChecked="{Binding IsDefaultMode,Mode=OneWay}"
					Checked="DefaultTemplateRadioButton_Checked" />
			</StackPanel>
			<StackPanel>
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_CellSize}" />
				<c:IntegerBox Value="{Binding RenderedCellSize}" MinValue="20" MaxValue="400" />
			</StackPanel>
			<StackPanel>
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_NumberOfRows}" />
				<c:IntegerBox Value="{Binding RowsCount}" MinValue="1" MaxValue="64" />
			</StackPanel>
			<StackPanel>
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_NumberOfColumns}" />
				<c:IntegerBox Value="{Binding ColumnsCount}" MinValue="1" MaxValue="64" />
			</StackPanel>
			<StackPanel
				Visibility="{Binding
					CreateCanvasMode,
					Mode=OneWay,
					UpdateSourceTrigger=PropertyChanged,
					Converter={StaticResource TemplateModeToVisibilityConverter},
					ConverterParameter={x:Static local:CreateCanvasMode.StandardTemplate}}">
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_NumberOfBlockRows}" />
				<c:IntegerBox Value="{Binding BlockRowsCount}" MinValue="1" MaxValue="64" />
			</StackPanel>
			<StackPanel
				Visibility="{Binding
					CreateCanvasMode,
					Mode=OneWay,
					UpdateSourceTrigger=PropertyChanged,
					Converter={StaticResource TemplateModeToVisibilityConverter},
					ConverterParameter={x:Static local:CreateCanvasMode.StandardTemplate}}">
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_NumberOfBlockColumns}" />
				<c:IntegerBox Value="{Binding BlockColumnsCount}" MinValue="1" MaxValue="64" />
			</StackPanel>
			<StackPanel>
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_RenderedGridMargin}" />
				<c:IntegerBox Value="{Binding RenderedGridMargin}" MinValue="0" MaxValue="100" />
			</StackPanel>
			<StackPanel Orientation="Vertical">
				<TextBlock
					Style="{StaticResource PropertyNameTextBlockStyle}"
					HorizontalAlignment="Left"
					Margin="0,0,0,4"
					Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_Vector}" />
				<Grid RowDefinitions="26,26,26,26" ColumnDefinitions="150,Auto">
					<Grid.Resources>
						<Style TargetType="TextBlock">
							<Setter Property="Margin" Value="10,0,0,0" />
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>
						<Style TargetType="c:IntegerBox">
							<Setter Property="Width" Value="100" />
							<Setter Property="VerticalAlignment" Value="Center" />
						</Style>
					</Grid.Resources>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_VectorTop}" />
					<c:IntegerBox Grid.Row="0" Grid.Column="1" Value="{Binding VectorTop}" MinValue="0" MaxValue="64" />
					<TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_VectorBottom}" />
					<c:IntegerBox Grid.Row="1" Grid.Column="1" Value="{Binding VectorBottom}" MinValue="0" MaxValue="64" />
					<TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_VectorLeft}" />
					<c:IntegerBox Grid.Row="2" Grid.Column="1" Value="{Binding VectorLeft}" MinValue="0" MaxValue="64" />
					<TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static p:LocalizationResources.CreateNewCanvasWindow_VectorRight}" />
					<c:IntegerBox Grid.Row="3" Grid.Column="1" Value="{Binding VectorRight}" MinValue="0" MaxValue="64" />
				</Grid>
			</StackPanel>
			<StackPanel>
				<CheckBox
					Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_IsBorderRoundedRectangle}"
					IsThreeState="False"
					IsChecked="{Binding IsBorderRoundedRectangle,Converter={StaticResource ThreeStateBooleanToBooleanConverter}}" />
			</StackPanel>
			<StackPanel
				Visibility="{Binding
					CreateCanvasMode,
					Mode=OneWay,
					UpdateSourceTrigger=PropertyChanged,
					Converter={StaticResource TemplateModeToVisibilityConverter},
					ConverterParameter={x:Static local:CreateCanvasMode.DefaultTemplate}}">
				<CheckBox
					Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_DrawBordersAsThickLines}"
					IsThreeState="False"
					IsChecked="{Binding DrawBordersAsThickLines,Converter={StaticResource ThreeStateBooleanToBooleanConverter}}" />
			</StackPanel>
			<Border BorderBrush="DimGray" BorderThickness="0,1.5,0,0" Margin="0,16,0,0">
				<StackPanel Margin="6,6,0,0">
					<Button
						Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_Create}"
						Margin="0,0,24,0"
						Click="CreateButton_Click" />
					<Button
						Content="{x:Static p:LocalizationResources.CreateNewCanvasWindow_Cancel}"
						Click="CancelButton_Click" />
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</Window>
