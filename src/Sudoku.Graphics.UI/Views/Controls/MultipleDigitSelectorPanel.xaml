<UserControl
	x:Class="Sudoku.Graphics.UI.Views.Controls.MultipleDigitSelectorPanel"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI.Views.Controls"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=local:MultipleDigitSelectorPanel}"
	d:DesignHeight="300" d:DesignWidth="300">
	<Border Padding="4">
		<Grid RowDefinitions="Auto,Auto">
			<Grid x:Name="PART_Root" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" />
			<Grid Grid.Row="1" Margin="0,6,0,0">
				<Button
					x:Name="PART_ConfirmButton"
					Content="{x:Static p:LocalizationResources.Confirm}"
					Margin="0,6"
					HorizontalAlignment="Right"
					Click="ConfirmButton_Click" />
			</Grid>
		</Grid>
	</Border>
</UserControl>
