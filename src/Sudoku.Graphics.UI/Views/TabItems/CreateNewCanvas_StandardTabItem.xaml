<UserControl
	x:Class="Sudoku.Graphics.UI.Views.TabItems.CreateNewCanvas_StandardTabItem"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI.Views.TabItems"
	xmlns:vm="clr-namespace:Sudoku.Graphics.UI.ViewModels"
	d:DataContext="{d:DesignInstance Type=vm:CreateNewCanvas_StandardTabItemViewModel}"
	mc:Ignorable="d">
	<UserControl.Resources>
		<Style TargetType="TextBox">
			<Setter Property="Width" Value="60"/>
		</Style>
	</UserControl.Resources>
	
	<StackPanel>
		<StackPanel Orientation="Horizontal" Margin="0,6">
			<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_CellSize}"/>
			<TextBox Text="{Binding CellSizeString,UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal" Margin="0,6">
			<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_Margin}"/>
			<TextBox Text="{Binding MarginString,UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal" Margin="0,6">
			<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_GridSize}"/>
			<TextBox Text="{Binding GridRowsCountString,UpdateSourceTrigger=PropertyChanged}"/>
			<TextBlock Text="x" Margin="6,0"/>
			<TextBox Text="{Binding GridColumnsCountString,UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>
		<StackPanel Orientation="Horizontal" Margin="0,6">
			<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_BlockSize}"/>
			<TextBox Text="{Binding BlockRowsCountString,UpdateSourceTrigger=PropertyChanged}"/>
			<TextBlock Text="x" Margin="6,0"/>
			<TextBox Text="{Binding BlockColumnsCountString,UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>
		<StackPanel Margin="0,6">
			<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_Vector}"/>
			<StackPanel Orientation="Horizontal" Margin="6,6,0,6">
				<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_VectorTop}"/>
				<TextBox Text="{Binding VectorTopString,UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="6,6,0,6">
				<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_VectorBottom}"/>
				<TextBox Text="{Binding VectorBottomString,UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="6,6,0,6">
				<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_VectorLeft}"/>
				<TextBox Text="{Binding VectorLeftString,UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="6,6,0,6">
				<TextBlock Text="{x:Static p:Resources.CreateNewCanvasWindow_VectorRight}"/>
				<TextBox Text="{Binding VectorRightString,UpdateSourceTrigger=PropertyChanged}"/>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>
