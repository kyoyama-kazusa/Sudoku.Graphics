<Window
	x:Class="Sudoku.Graphics.UI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="clr-namespace:Sudoku.Graphics.UI.ViewModels"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
	mc:Ignorable="d"
	Title="{x:Static p:Resources.MainWindow_Title}"
	MinHeight="860"
	Height="960"
	Width="1600">
	<Window.InputBindings>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding OpenCreateNewCanvasCommand}"/>
		<KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCommand}"/>
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveImageCommand}"/>
		<KeyBinding Gesture="Alt+F4" Command="{Binding QuitCommand}"/>
	</Window.InputBindings>

	<Grid RowDefinitions="Auto,*">
		<Menu Grid.Row="0">
			<MenuItem Header="{x:Static p:Resources.MainWindow_MenuItem_File}">
				<MenuItem
					Header="{x:Static p:Resources.MainWindow_MenuItem_Create}"
					Command="{Binding OpenCreateNewCanvasCommand}"
					InputGestureText="Ctrl+N"/>
				<MenuItem
					Header="{x:Static p:Resources.MainWindow_MenuItem_Close}"
					Command="{Binding CloseCommand}"
					InputGestureText="Ctrl+W"/>
				<MenuItem
					Header="{x:Static p:Resources.MainWindow_MenuItem_Save}"
					Command="{Binding SaveImageCommand}"
					InputGestureText="Ctrl+S"/>
				<Separator/>
				<MenuItem
					Header="{x:Static p:Resources.MainWindow_MenuItem_Quit}"
					InputGestureText="Alt+F4"
					Command="{Binding QuitCommand}"
					CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
			</MenuItem>
			<MenuItem
				Header="{x:Static p:Resources.MainWindow_MenuItem_About}"
				Command="{Binding OpenAboutWindowCommand}"
				CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
			</MenuItem>
		</Menu>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*">
			<Border
				Grid.Column="0"
				Margin="16,16,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				BorderBrush="LightGray"
				BorderThickness="1"
				MaxWidth="800">
				<Image
					x:Name="GridDisplayer"
					Stretch="Uniform"
					Source="{Binding RenderedImage,UpdateSourceTrigger=PropertyChanged}" />
			</Border>
		</Grid>
	</Grid>
</Window>
