<Window
	x:Class="Sudoku.Graphics.UI.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:Sudoku.Graphics.UI"
	xmlns:p="clr-namespace:Sudoku.Graphics.UI.Properties"
	xmlns:c="clr-namespace:Sudoku.Graphics.UI.Views.Controls"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=local:MainWindow}"
	Title="{x:Static p:LocalizationResources.MainWindow_MenuItem_Title}"
	Height="900"
	Width="1600"
	WindowStartupLocation="CenterScreen"
	Initialized="Window_Initialized"
	Closing="Window_Closing">
	<Window.Resources>
		<Style TargetType="Border">
			<Setter Property="BorderBrush" Value="Black" />
		</Style>
	</Window.Resources>
	<Window.InputBindings>
		<KeyBinding Gesture="Alt+F4" Command="{Binding QuitCommand}" />
		<KeyBinding Gesture="Ctrl+N" Command="{Binding CreateCanvasCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding LoadFromLocalCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCanvasCommand}" />
		<KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCanvasCommand}" />
		<KeyBinding Gesture="F12" Command="{Binding SaveAsJsonCommand}" />
	</Window.InputBindings>
	
	<Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*">
		<Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
			<MenuItem Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_File}">
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_CreateCanvas}"
					Command="{Binding CreateCanvasCommand}"
					InputGestureText="Ctrl+N" />
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_CloseCanvas}"
					Command="{Binding CloseCanvasCommand}"
					InputGestureText="Ctrl+W" />
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_SaveCanvas}"
					Command="{Binding SaveCanvasCommand}"
					InputGestureText="Ctrl+S" />
				<Separator />
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_LoadCanvasFromLocal}"
					Command="{Binding LoadFromLocalCommand}"
					InputGestureText="Ctrl+O" />
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_SaveAsConfig}"
					Command="{Binding SaveAsJsonCommand}"
					InputGestureText="F12" />
				<Separator />
				<MenuItem
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_Quit}"
					Command="{Binding QuitCommand}"
					InputGestureText="Alt+F4" />
			</MenuItem>
			<MenuItem Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_About}">
				<MenuItem
					x:Name="AboutMeMenuItem"
					Header="{x:Static p:LocalizationResources.MainWindow_MenuItem_AboutMe}"
					Click="AboutMeMenuItem_Click" />
			</MenuItem>
		</Menu>
		<Popup x:Name="DigitSelectorPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
			<Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="6">
				<c:DigitSelectorPanel
					x:Name="DigitSelectorPanel"
					CellSize="48"
					FontFamily="Arial"
					FontSize="28"
					FontWeight="Bold"
					Foreground="Black"
					SelectedDigitChanged="DigitSelectorPanel_SelectedDigitChanged" />
			</Border>
		</Popup>
		<Border Grid.Row="1" Grid.Column="0" BorderThickness="2" Margin="16">
			<Image
				Width="800"
				Height="800"
				Source="{Binding GridImageSource}"
				MouseDown="Image_MouseDown"
				MouseUp="Image_MouseUp" />
		</Border>
		<Border Grid.Row="1" Grid.Column="1" BorderThickness="2" Margin="16">
			<Grid RowDefinitions="Auto,*">
				<Border Grid.Row="0" BorderBrush="DimGray" BorderThickness="0,0,0,1">
					<TextBlock FontSize="20" Margin="8,12,0,12">
						<Run Text="{x:Static p:LocalizationResources.MainWindow_CurrentMode}" FontWeight="Bold" />
						<Run Text="{Binding CurrentModeString}" FontWeight="Bold" Foreground="Red" />
					</TextBlock>
				</Border>
				<ScrollViewer Grid.Row="1" Margin="0,20,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{StaticResource BuiltInToolItemGroups}" Margin="6,0,0,0">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Margin="0,0,0,25" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel>
									<Border BorderBrush="DimGray" Margin="8,0,8,12" BorderThickness="0,0,0,1">
										<TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="20" />
									</Border>
									<ItemsControl ItemsSource="{Binding Items}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<UniformGrid Columns="5" HorizontalAlignment="Left" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid RowDefinitions="Auto,*" Width="64" Margin="24,0,0,0">
													<Button
														Grid.Row="0"
														HorizontalAlignment="Center"
														Tag="{Binding}"
														Click="ToolItemButton_Click">
														<Image Source="{Binding Icon}" />
													</Button>
													<TextBlock
														Grid.Row="1"
														Text="{Binding ItemString}"
														Margin="0,3,0,0"
														TextWrapping="Wrap"
														HorizontalAlignment="Center" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>
	</Grid>
</Window>
